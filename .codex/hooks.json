{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'node \"$(git rev-parse --show-toplevel)/.harness/hooks/guardia-bash.mjs\" --agente codex'"
          }
        ]
      },
      {
        "matcher": "apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'node \"$(git rev-parse --show-toplevel)/.harness/hooks/guardia-archivos.mjs\" --agente codex'"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'node \"$(git rev-parse --show-toplevel)/.harness/hooks/verificar-fin.mjs\" --agente codex'"
          }
        ]
      }
    ]
  }
}
