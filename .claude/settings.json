{
  "effortLevel": "high",
  "permissions": {
    "disableBypassPermissionsMode": "disable",
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(node .harness/bin/verificar.mjs *)",
      "Bash(node .harness/bin/riesgo.mjs *)",
      "Bash(node .harness/bin/bitacora.mjs *)",
      "Bash(node .harness/bin/doctor.mjs *)",
      "Bash(node .harness/bin/metricas.mjs *)"
    ],
    "ask": [
      "Bash(gh pr merge *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.production)",
      "Read(**/*.pem)",
      "Read(**/*.ppk)",
      "Read(**/*.key)",
      "Read(**/userlist.txt)",
      "Read(**/datastore.properties)",
      "Read(**/.pgpass)",
      "Bash(crontab -r *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.harness/hooks/bitacora.mjs\" --agente claude --evento inicio",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.harness/hooks/modelo.mjs\" --evento SessionStart",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "startup|resume|compact|clear",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.harness/hooks/contexto-inicio.mjs\" --agente claude",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.harness/hooks/guardia-bash.mjs\" --agente claude",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.harness/hooks/guardia-archivos.mjs\" --agente claude",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.harness/hooks/bitacora.mjs\" --agente claude",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "PreModelSwitch": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.harness/hooks/modelo.mjs\" --evento PreModelSwitch",
            "timeout": 10
          }
        ]
      }
    ],
    "PostModelSwitch": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.harness/hooks/modelo.mjs\" --evento PostModelSwitch",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.harness/hooks/verificar-fin.mjs\" --agente claude",
            "timeout": 1500
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.harness/hooks/bitacora.mjs\" --agente claude --evento fin",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
